# 券商营销话术合规审核引擎 —— 环境变量模板
# 使用方式：cp .env.example .env，填入真实值即可，程序启动时经 python-dotenv 自动加载
# （shell 中已 export 的同名变量优先级更高；.env 缺失时自动跳过，不影响离线运行）
# 严禁将真实 API Key 硬编码进代码或提交到 git 仓库

# OpenAI 兼容协议的 Base URL（DeepSeek/通义/Kimi/OpenAI 等均适用）
# DeepSeek 示例：https://api.deepseek.com
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key（留空或不配置时，引擎自动降级为纯本地规则模式，离线可用）
LLM_API_KEY=

# 模型名称
LLM_MODEL=gpt-4o-mini

# 单次 LLM 请求超时时间（秒），超时触发 fail-closed 兜底
LLM_TIMEOUT=15

# 批量审核的最大并发数
LLM_CONCURRENCY=8
